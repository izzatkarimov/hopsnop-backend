DATABASE_URL=postgresql+psycopg://hopsnop:hopsnop@localhost:5433/hopsnop

# "development" makes the session cookie usable over plain HTTP and writes
# email verification / password reset links to the server log instead of
# sending them. Leaving this unset means "production".
ENVIRONMENT=development

# Where the web frontend is served: the base of emailed links, and the only
# other origin allowed to call this API from a browser. In development it
# defaults to this value. In production it has no default: it must be set,
# and to an https URL, or the application does not start.
FRONTEND_URL=http://localhost:3000

# Key of the hashes under which rate-limit counters are stored. Development
# has a built-in value. Production must set its own, at least 32 characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# RATE_LIMIT_SECRET=

# How long rows that are no longer used are kept before
# `python -m app.purge --execute --database <name> --host <host:port>`
# removes them, counted from when they stop being of use. These are the
# defaults; see README, Retention. The purge must run with the same
# environment as the application.
# EXPIRED_STORY_RETENTION_HOURS=24
# ENDED_SESSION_RETENTION_DAYS=30
# SPENT_TOKEN_RETENTION_DAYS=7
# RATE_LIMIT_RETENTION_HOURS=1
# PURGE_BATCH_SIZE=1000

# Accounts whose email address was never verified are not removed unless
# this is true. Leave it off wherever verification emails are not delivered
# (outside development none is sent yet): switched on there, every
# registration is removed once it is this many days old.
# PURGE_UNVERIFIED_ACCOUNTS=false
# UNVERIFIED_ACCOUNT_RETENTION_DAYS=7
