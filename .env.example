DATABASE_URL=postgresql+psycopg://hopsnop:hopsnop@localhost:5433/hopsnop

# "development" makes the session cookie usable over plain HTTP and writes
# email verification / password reset links to the server log instead of
# sending them. Leaving this unset means "production".
ENVIRONMENT=development

# Where the web frontend is served: the base of emailed links, and the only
# other origin allowed to call this API from a browser.
FRONTEND_URL=http://localhost:3000
